{
  "name": "beta-cinemas-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Demo Beta Cinemas - giao dịch treo, đối soát và hoàn tiền tự động (frontend + api + gateway-mock)",
  "scripts": {
    "start": "node server.js",
    "setup": "npm install && npm --prefix api install && npm --prefix gateway-mock install",
    "dev": "npm --prefix api run dev",
    "dev:all": "concurrently -k -n api,gateway -c blue,magenta \"npm:dev:api\" \"npm:dev:gateway\"",
    "dev:api": "npm --prefix api run dev",
    "dev:gateway": "npm --prefix gateway-mock run dev",
    "test": "npm --prefix api test && npm --prefix gateway-mock test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.7.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.1.0",
    "sepay-pg-node": "^1.0.0",
    "zod": "^3.24.1"
  }
}
