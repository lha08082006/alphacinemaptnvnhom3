{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/sepay/(.*)", "destination": "/api/index.js" },
    { "source": "/dang-nhap", "destination": "/dang-nhap.html" },
    { "source": "/booking", "destination": "/booking.html" },
    { "source": "/seats", "destination": "/booking.html" },
    { "source": "/checkout", "destination": "/checkout.html" },
    { "source": "/result", "destination": "/result.html" },
    { "source": "/admin", "destination": "/admin/login.html" },
    { "source": "/admin/login", "destination": "/admin/login.html" }
  ]
}
