{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": ".",
      "framework": "express",
      "entrypoint": "server.js",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "API_URL"
        }
      ]
    },
    "api": {
      "root": "api",
      "framework": "express",
      "entrypoint": "src/server.js",
      "bindings": [
        {
          "type": "service",
          "service": "beta-payment-demo",
          "format": "url",
          "env": "GATEWAY_BASE_URL"
        }
      ]
    },
    "beta-payment-demo": {
      "root": "beta-payment-demo",
      "framework": "express",
      "entrypoint": "server.js"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/sepay/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
