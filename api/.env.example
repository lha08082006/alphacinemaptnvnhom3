# Sao chép thành api\.env trước khi chạy:
#   Copy-Item api\.env.example api\.env
# Không commit file .env thật.

NODE_ENV=development
PORT=4000

# Đường dẫn tương đối tính từ thư mục api\
DB_FILE=data/beta.sqlite

# Các origin được phép gọi API (Live Server). Ngăn cách bằng dấu phẩy.
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Địa chỉ cổng thanh toán giả lập (gateway-mock)
GATEWAY_BASE_URL=http://127.0.0.1:4100

# PHẢI giống hệt WEBHOOK_SECRET trong gateway-mock\.env (tối thiểu 16 ký tự)
WEBHOOK_SECRET=dev_webhook_secret_change_me_0123
# Độ lệch tối đa (giây, theo GIỜ THẬT) giữa X-Gateway-Timestamp và lúc nhận webhook
WEBHOOK_TOLERANCE_SEC=300

# Dùng từ BE-02 (đăng nhập). Tối thiểu 16 ký tự.
JWT_SECRET=dev_jwt_secret_change_me_0123456789
JWT_EXPIRES_IN=2h

# debug | info | warn | error | silent
LOG_LEVEL=info

# Cấu hình VNPay (Sandbox)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_URL=http://localhost:4000/api/v1/payment/vnpay/return
VNPAY_TRUST_RETURN=false

# Cấu hình Gemini AI (Tùy chọn)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
